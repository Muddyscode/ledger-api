# Copy to .env for local (non-Compose) runs. Never commit .env.
# Compose already injects these; values below are DEV ONLY.

LEDGER_DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
LEDGER_HTTP_ADDR=:8080

# At least 32 characters. Rotate before any real deployment.
LEDGER_JWT_SECRET=dev-only-change-me-use-32chars-min!!

# Registration is on for the demo. Turn off if you expose this beyond localhost.
LEDGER_ALLOW_REGISTER=true

# Seed the demo operator + chart of accounts on boot.
LEDGER_SEED=true
LEDGER_SEED_EMAIL=operator@ledger.local
LEDGER_SEED_PASSWORD=change-me-now-12
